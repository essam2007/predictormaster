# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).

# --- Mode ---------------------------------------------------------------
# demo | live | backtest. Live additionally requires ICT_TRADER_LIVE_CONFIRM below.
ICT_TRADER_MODE=demo
# Required to arm the LIVE endpoint. Must equal the literal string I_UNDERSTAND_THE_RISK.
ICT_TRADER_LIVE_CONFIRM=

# --- Storage ------------------------------------------------------------
# SQLite for MVP; switch to postgresql+asyncpg://user:pass@host/db before live.
ICT_TRADER_DB_URL=sqlite+aiosqlite:///./ict_trader.db

# --- Tradovate credentials (execution) ----------------------------------
TRADOVATE_NAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=ict-trader
TRADOVATE_APP_VERSION=0.1.0
TRADOVATE_CID=
TRADOVATE_SECRET=
TRADOVATE_DEVICE_ID=

# --- Market data feed ---------------------------------------------------
# tradovate | databento | replay
ICT_TRADER_FEED=tradovate
DATABENTO_API_KEY=

# --- Research-deck API --------------------------------------------------
ICT_TRADER_API_HOST=127.0.0.1
ICT_TRADER_API_PORT=8077
# Bearer token required for control routes (kill switch etc.).
ICT_TRADER_CONTROL_TOKEN=
# Shared secret a TradingView/Pine webhook must include.
ICT_TRADER_WEBHOOK_SECRET=
