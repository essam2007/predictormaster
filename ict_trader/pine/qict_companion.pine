//@version=6
// ICT Quarterly Companion — manual demo-trading aid for TradingView Paper Trading.
//
// Run this on CME_MINI:NQ1! (1m–5m). It marks the ICT setup and ALERTS you when a long/short
// appears, with a readable "enter / stop / target" message so you can place the paper trade
// by hand. It does NOT place orders. This is a SIMPLIFIED visual aid — the Python engine in
// this repo is the faithful detector (nested SMT, true low-resistance-path scan, etc.).
//
// Setup in TradingView: Pine Editor -> paste -> Add to chart -> set the "Correlated symbol"
// input to the matching ES contract -> right-click the BUY/SELL marker -> Add alert ->
// "Once Per Bar Close".
indicator("ICT Quarterly Companion", overlay = true, max_boxes_count = 120,
     max_lines_count = 60, max_labels_count = 120)

// ---------------- inputs ----------------
es_sym        = input.symbol("CME_MINI:ES1!", "Correlated symbol (ES)")
show_fvg      = input.bool(true,  "Fair value gaps")
show_ifvg     = input.bool(true,  "Inverse FVG (entry trigger)")
show_kz       = input.bool(true,  "Killzone / Silver Bullet shading")
show_erl      = input.bool(true,  "ERL target lines (PDH/PDL)")
min_fvg_ticks = input.float(2.0,  "Min FVG size (ticks)")
buf_ticks     = input.float(2.0,  "Stop buffer (ticks)")
want_alerts   = input.bool(true,  "Fire BUY/SELL alerts")

tick = syminfo.mintick
minsize = tick * min_fvg_ticks

// ---------------- time (ET) ----------------
in_kz   = not na(time(timeframe.period, "0700-1000", "America/New_York"))
in_sb   = not na(time(timeframe.period, "1000-1100", "America/New_York"))
in_news = not na(time(timeframe.period, "0830-0832", "America/New_York"))
dow     = dayofweek(time, "America/New_York")
avoid_day = dow == dayofweek.friday or dow == dayofweek.saturday or dow == dayofweek.sunday
tradeable_time = (in_kz or in_sb) and not in_news and not avoid_day

bgcolor(show_kz and in_sb ? color.new(color.orange, 90) : na, title = "Silver Bullet")
bgcolor(show_kz and in_kz and not in_sb ? color.new(color.blue, 93) : na, title = "NY-AM KZ")

// ---------------- ERL (prior-day high/low) ----------------
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_on)
var line pdh_line = na
var line pdl_line = na
if show_erl and barstate.islast
    line.delete(pdh_line)
    line.delete(pdl_line)
    pdh_line := line.new(bar_index - 50, pdh, bar_index + 5, pdh, color = color.teal,
         style = line.style_dashed)
    pdl_line := line.new(bar_index - 50, pdl, bar_index + 5, pdl, color = color.maroon,
         style = line.style_dashed)

// ---------------- fair value gaps (chart symbol) ----------------
bull_fvg = low > high[2] and (low - high[2]) >= minsize
bear_fvg = high < low[2] and (low[2] - high) >= minsize
if show_fvg and bull_fvg
    box.new(bar_index[2], low, bar_index, high[2], border_color = color.new(color.green, 40),
         bgcolor = color.new(color.green, 88))
if show_fvg and bear_fvg
    box.new(bar_index[2], low[2], bar_index, high, border_color = color.new(color.red, 40),
         bgcolor = color.new(color.red, 88))

// ---------------- inverse FVG (body-close-through) -> entry trigger ----------------
// Track the most recent opposing FVG bounds; an IFVG forms when a BODY closes through it.
var float bear_lo = na, var float bear_hi = na
var float bull_lo = na, var float bull_hi = na
if bear_fvg
    bear_lo := high, bear_hi := low[2]
if bull_fvg
    bull_lo := high[2], bull_hi := low

bull_ifvg = not na(bear_hi) and close > bear_hi      // bearish FVG flipped up = bullish support
bear_ifvg = not na(bull_lo) and close < bull_lo      // bullish FVG flipped down = bearish resist
if show_ifvg and bull_ifvg
    box.new(bar_index - 1, bear_lo, bar_index, bear_hi, border_color = color.lime,
         bgcolor = color.new(color.lime, 80))
    bear_hi := na  // consume
if show_ifvg and bear_ifvg
    box.new(bar_index - 1, bull_lo, bar_index, bull_hi, border_color = color.fuchsia,
         bgcolor = color.new(color.fuchsia, 80))
    bull_lo := na

// ---------------- ES/NQ SMT + PSP ----------------
es_low   = request.security(es_sym, timeframe.period, low,   barmerge.gaps_off, barmerge.lookahead_off)
es_high  = request.security(es_sym, timeframe.period, high,  barmerge.gaps_off, barmerge.lookahead_off)
es_open  = request.security(es_sym, timeframe.period, open,  barmerge.gaps_off, barmerge.lookahead_off)
es_close = request.security(es_sym, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)

nq_ll = low  < ta.lowest(low, 5)[1]
es_ll = es_low < ta.lowest(es_low, 5)[1]
bull_smt = nq_ll != es_ll
nq_hh = high > ta.highest(high, 5)[1]
es_hh = es_high > ta.highest(es_high, 5)[1]
bear_smt = nq_hh != es_hh
psp = (close > open) != (es_close > es_open)

plotshape(bull_smt and barstate.isconfirmed, title = "Bull SMT", style = shape.triangleup,
     location = location.belowbar, color = color.green, size = size.tiny)
plotshape(bear_smt and barstate.isconfirmed, title = "Bear SMT", style = shape.triangledown,
     location = location.abovebar, color = color.red, size = size.tiny)
plotchar(psp and barstate.isconfirmed, title = "PSP", char = "•", location = location.top,
     color = color.yellow, size = size.tiny)

// ---------------- composite signal ----------------
long_sig  = barstate.isconfirmed and tradeable_time and bull_ifvg and bull_smt
short_sig = barstate.isconfirmed and tradeable_time and bear_ifvg and bear_smt

long_entry  = not na(bear_lo) ? (bear_lo + bear_hi) / 2 : close
long_stop   = not na(bear_lo) ? bear_lo - buf_ticks * tick : low - buf_ticks * tick
short_entry = not na(bull_lo) ? (bull_lo + bull_hi) / 2 : close
short_stop  = not na(bull_hi) ? bull_hi + buf_ticks * tick : high + buf_ticks * tick

plotshape(long_sig,  title = "BUY",  style = shape.labelup,   location = location.belowbar,
     color = color.new(color.green, 0), text = "BUY",  textcolor = color.white, size = size.small)
plotshape(short_sig, title = "SELL", style = shape.labeldown, location = location.abovebar,
     color = color.new(color.red, 0),   text = "SELL", textcolor = color.white, size = size.small)

// ---------------- alerts (readable) ----------------
if want_alerts and long_sig
    alert("ICT LONG " + syminfo.ticker + " — enter ~" + str.tostring(long_entry, format.mintick) +
         ", stop ~" + str.tostring(long_stop, format.mintick) +
         ", target PDH ~" + str.tostring(pdh, format.mintick) +
         ". Hold a runner to target; do NOT move to breakeven on the first pullback.",
         alert.freq_once_per_bar_close)
if want_alerts and short_sig
    alert("ICT SHORT " + syminfo.ticker + " — enter ~" + str.tostring(short_entry, format.mintick) +
         ", stop ~" + str.tostring(short_stop, format.mintick) +
         ", target PDL ~" + str.tostring(pdl, format.mintick) +
         ". Hold a runner to target; do NOT move to breakeven on the first pullback.",
         alert.freq_once_per_bar_close)

// one-click alertcondition variants
alertcondition(long_sig,  title = "ICT Long",  message = "ICT LONG setup on {{ticker}}")
alertcondition(short_sig, title = "ICT Short", message = "ICT SHORT setup on {{ticker}}")
