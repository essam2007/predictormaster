# Predictormaster live-trading credentials.
# Copy to .env and fill in. NEVER commit .env.
#
# Generated from Polymarket UI → Settings → API Keys → "Create API key".
# POLY_PROXY_ADDRESS is the 0x… shown in Settings (NOT the EOA in MetaMask).
# POLY_FUNDER_PK is your MetaMask private key (Account details → Show private key).

POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_PROXY_ADDRESS=
POLY_FUNDER_PK=

# Optional: paid odds API (enables α2 cross-venue arb against sportsbook
# consensus and α6 public-bias fade). 500 req/month on free tier.
# THE_ODDS_API_KEY=

# Optional: Reddit (text-source for α3 sentiment shock).
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=predictormaster/0.1 by your_username

# Optional: monitor-only Discord webhook for fill / reject notifications.
# DISCORD_WEBHOOK=
